        <mxCell id="title" value="ERD v1.1 - HỆ THỐNG HỌC TRỰC TUYẾN (E-LEARNING)" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry y="20" width="3266" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;CHÚ THÍCH&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc&quot;&gt;&amp;nbsp;Xanh dương&amp;nbsp;&lt;/span&gt; Người dùng &amp;amp; vai trò&lt;br&gt;&lt;span style=&quot;background:#d5e8d4&quot;&gt;&amp;nbsp;Xanh lá&amp;nbsp;&lt;/span&gt; Môn học, lớp, đăng ký, học tập&lt;br&gt;&lt;span style=&quot;background:#fff2cc&quot;&gt;&amp;nbsp;Vàng&amp;nbsp;&lt;/span&gt; Phân công &amp;amp; lương giáo viên&lt;br&gt;&lt;span style=&quot;background:#e1d5e7&quot;&gt;&amp;nbsp;Tím&amp;nbsp;&lt;/span&gt; Ngân hàng câu hỏi &amp;amp; thi cuối kỳ&lt;br&gt;&lt;span style=&quot;background:#ffe6cc&quot;&gt;&amp;nbsp;Cam&amp;nbsp;&lt;/span&gt; Quiz theo chương&lt;br&gt;&lt;br&gt;Ký hiệu chân gà: &lt;b&gt;||&lt;/b&gt; đúng một · &lt;b&gt;o|&lt;/b&gt; không hoặc một · &lt;b&gt;o&amp;lt;&lt;/b&gt; không hoặc nhiều · &lt;b&gt;|&amp;lt;&lt;/b&gt; một hoặc nhiều.&lt;br&gt;USER là bảng cha của ADMIN, TEACHER, STUDENT qua quan hệ ROLE (user_id vừa là PK vừa là FK)." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
