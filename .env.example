# Chép file này thành `.env` rồi điền giá trị (lệnh `npm run setup` tự chép nếu chưa có).
# Không commit file `.env`.

# --- CSDL PostgreSQL (Docker Compose) ---
# Dùng cổng 5440 để không đụng PostgreSQL khác trên máy (5432, 5433). Đổi cả hai dòng nếu cổng này bận.
POSTGRES_USER=elearning
POSTGRES_PASSWORD=elearning
POSTGRES_DB=elearning
POSTGRES_PORT=5440
DATABASE_URL="postgresql://elearning:elearning@localhost:5440/elearning?schema=public"

# --- Ứng dụng ---
APP_URL="http://localhost:3000"

# --- Xác thực (Auth.js) — dùng từ Sprint 1 ---
# Tạo bằng lệnh: npx auth secret
AUTH_SECRET=""

# --- Stripe chế độ test — dùng từ Sprint 2 ---
# Lấy ở https://dashboard.stripe.com/test/apikeys (chỉ dùng khoá bắt đầu bằng sk_test_ / pk_test_)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Lấy khi chạy: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# --- File tải lên ---
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB=10
