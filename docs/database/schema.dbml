// =====================================================================
// E-Learning Platform — Database schema (DBML)
//
// Cách xem sơ đồ: copy toàn bộ file này, paste vào https://dbdiagram.io
//   -> Export PNG/PDF để đưa vào báo cáo
//   -> Export PostgreSQL để ra file SQL tạo bảng
//
// Quy ước:
//   - Tên bảng: snake_case, số nhiều. Khoá chính: uuid.
//   - Tiền: decimal (không dùng float). Thời gian: timestamptz.
//   - Xem giải thích thiết kế trong docs/database/ERD.md
// =====================================================================

Project elearning {
  database_type: 'PostgreSQL'
  Note: 'Nền tảng học và bán khoá học trực tuyến. Vai trò: STUDENT, TEACHER (ADMIN dự phòng cho giai đoạn sau).'
}

// ---------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------

Enum user_role {
  STUDENT
  TEACHER
  ADMIN
}

Enum course_level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

Enum course_status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

Enum lesson_type {
  VIDEO
  ARTICLE
  QUIZ
  ASSIGNMENT
}

Enum question_type {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

Enum difficulty_level {
  EASY
  MEDIUM
  HARD
}

Enum quiz_type {
  LESSON_QUIZ
  MIDTERM
  FINAL
}

Enum quiz_status {
  DRAFT
  PUBLISHED
}

Enum attempt_status {
  IN_PROGRESS
  SUBMITTED
}

Enum enrollment_status {
  ACTIVE
  COMPLETED
  CANCELLED
}

Enum progress_status {
  IN_PROGRESS
  COMPLETED
}

Enum submission_status {
  SUBMITTED
  GRADED
}

Enum order_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

Enum payment_provider {
  VNPAY
  MOMO
  BANK_TRANSFER
}

Enum payment_status {
  PENDING
  SUCCESS
  FAILED
}

// ---------------------------------------------------------------------
// 1. Người dùng & khoá học
// ---------------------------------------------------------------------

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null, note: 'bcrypt/argon2 — không bao giờ lưu mật khẩu thô']
  full_name varchar(150) [not null]
  avatar_url varchar(500)
  role user_role [not null, default: 'STUDENT']
  bio text [note: 'Giới thiệu bản thân — dùng cho hồ sơ giảng viên']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table categories {
  id uuid [pk, default: `gen_random_uuid()`]
  parent_id uuid [ref: > categories.id, note: 'Danh mục cha, null = danh mục gốc']
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
}

Table courses {
  id uuid [pk, default: `gen_random_uuid()`]
  teacher_id uuid [not null, ref: > users.id, note: 'GV sở hữu khoá — cột dùng để phân quyền GV']
  category_id uuid [ref: > categories.id]
  title varchar(200) [not null]
  slug varchar(220) [not null, unique]
  summary varchar(500)
  description text
  thumbnail_url varchar(500)
  price decimal(12,2) [not null, default: 0, note: '0 = khoá miễn phí']
  level course_level [not null, default: 'BEGINNER']
  status course_status [not null, default: 'DRAFT', note: 'Khoá đã có người mua thì ARCHIVED, không xoá']
  published_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    teacher_id
    (status, category_id)
  }
}

Table sections {
  id uuid [pk, default: `gen_random_uuid()`]
  course_id uuid [not null, ref: > courses.id]
  title varchar(200) [not null]
  position int [not null, note: 'Thứ tự chương — hỗ trợ kéo thả sắp xếp']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (course_id, position)
  }
}

Table lessons {
  id uuid [pk, default: `gen_random_uuid()`]
  section_id uuid [not null, ref: > sections.id]
  title varchar(200) [not null]
  type lesson_type [not null]
  content text [note: 'Nội dung bài đọc (Markdown/HTML)']
  video_url varchar(500) [note: 'URL từ Cloudinary/S3/YouTube — không lưu file video trong DB']
  duration_seconds int
  position int [not null]
  is_preview boolean [not null, default: false, note: 'Cho xem thử khi chưa mua']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (section_id, position)
  }
}

// ---------------------------------------------------------------------
// 2. Ngân hàng câu hỏi & bài kiểm tra
// ---------------------------------------------------------------------

Table questions {
  id uuid [pk, default: `gen_random_uuid()`]
  course_id uuid [not null, ref: > courses.id, note: 'Kho câu hỏi thuộc về một khoá học']
  type question_type [not null]
  content text [not null]
  difficulty difficulty_level [not null, default: 'MEDIUM']
  explanation text [note: 'Giải thích đáp án, hiện sau khi SV nộp bài']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [note: 'Xoá mềm — câu hỏi đã có trong bài làm thì không được xoá cứng']

  indexes {
    course_id
  }
}

Table question_options {
  id uuid [pk, default: `gen_random_uuid()`]
  question_id uuid [not null, ref: > questions.id]
  content text [not null]
  is_correct boolean [not null, default: false]
  position int [not null]
}

Table quizzes {
  id uuid [pk, default: `gen_random_uuid()`]
  course_id uuid [not null, ref: > courses.id]
  lesson_id uuid [unique, ref: - lessons.id, note: 'Chỉ có khi type = LESSON_QUIZ; null với đề giữa kì / cuối kì']
  type quiz_type [not null]
  title varchar(200) [not null]
  description text
  time_limit_minutes int [note: 'null = không giới hạn thời gian']
  pass_score decimal(5,2) [note: 'Điểm đạt']
  max_attempts int [note: 'null = không giới hạn số lần làm']
  shuffle_questions boolean [not null, default: true]
  open_at timestamptz
  close_at timestamptz
  status quiz_status [not null, default: 'DRAFT']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    course_id
  }
}

Table quiz_questions {
  quiz_id uuid [not null, ref: > quizzes.id]
  question_id uuid [not null, ref: > questions.id]
  position int [not null]
  points decimal(5,2) [not null, default: 1, note: 'Điểm của câu này trong đề này']

  indexes {
    (quiz_id, question_id) [pk]
  }
}

Table quiz_attempts {
  id uuid [pk, default: `gen_random_uuid()`]
  quiz_id uuid [not null, ref: > quizzes.id]
  enrollment_id uuid [not null, ref: > enrollments.id]
  attempt_no int [not null, note: 'Lần làm thứ mấy']
  status attempt_status [not null, default: 'IN_PROGRESS']
  started_at timestamptz [not null, default: `now()`]
  submitted_at timestamptz
  score decimal(5,2)
  is_passed boolean

  indexes {
    (quiz_id, enrollment_id, attempt_no) [unique]
  }
}

Table attempt_answers {
  id uuid [pk, default: `gen_random_uuid()`]
  attempt_id uuid [not null, ref: > quiz_attempts.id]
  question_id uuid [not null, ref: > questions.id]
  selected_option_ids jsonb [not null, note: 'Mảng id các đáp án SV đã chọn']
  is_correct boolean
  points_earned decimal(5,2) [not null, default: 0]

  indexes {
    (attempt_id, question_id) [unique]
  }
}

// ---------------------------------------------------------------------
// 3. Đăng ký, tiến độ & bài tập thực hành
// ---------------------------------------------------------------------

Table enrollments {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null, ref: > users.id]
  course_id uuid [not null, ref: > courses.id]
  order_item_id uuid [unique, ref: - order_items.id, note: 'null nếu khoá miễn phí']
  status enrollment_status [not null, default: 'ACTIVE']
  progress_percent decimal(5,2) [not null, default: 0, note: 'Cache — tính lại từ lesson_progress mỗi khi hoàn thành bài']
  enrolled_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  last_accessed_at timestamptz

  indexes {
    (student_id, course_id) [unique]
    course_id
  }
}

Table lesson_progress {
  id uuid [pk, default: `gen_random_uuid()`]
  enrollment_id uuid [not null, ref: > enrollments.id]
  lesson_id uuid [not null, ref: > lessons.id]
  status progress_status [not null, default: 'IN_PROGRESS']
  last_position_seconds int [not null, default: 0, note: 'Để SV xem tiếp video từ vị trí cũ']
  completed_at timestamptz
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (enrollment_id, lesson_id) [unique]
  }
}

Table assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  lesson_id uuid [not null, unique, ref: - lessons.id, note: 'Lesson có type = ASSIGNMENT']
  instructions text [not null]
  attachment_url varchar(500) [note: 'File đề bài / starter code']
  max_score decimal(5,2) [not null, default: 10]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table submissions {
  id uuid [pk, default: `gen_random_uuid()`]
  assignment_id uuid [not null, ref: > assignments.id]
  enrollment_id uuid [not null, ref: > enrollments.id]
  content text [note: 'Bài làm dạng text hoặc link GitHub']
  file_url varchar(500)
  status submission_status [not null, default: 'SUBMITTED']
  score decimal(5,2)
  feedback text [note: 'Nhận xét của GV']
  submitted_at timestamptz [not null, default: `now()`]
  graded_at timestamptz

  indexes {
    (assignment_id, enrollment_id) [unique]
  }
}

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  enrollment_id uuid [not null, unique, ref: - enrollments.id, note: 'Chỉ SV đã đăng ký mới được đánh giá, mỗi người 1 lần']
  rating smallint [not null, note: '1 đến 5 sao']
  comment text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// 4. Bán khoá học
// ---------------------------------------------------------------------

Table orders {
  id uuid [pk, default: `gen_random_uuid()`]
  student_id uuid [not null, ref: > users.id]
  order_code varchar(30) [not null, unique, note: 'Mã gửi sang cổng thanh toán (vd: vnp_TxnRef)']
  total_amount decimal(12,2) [not null]
  status order_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
  paid_at timestamptz

  indexes {
    student_id
  }
}

Table order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > orders.id]
  course_id uuid [not null, ref: > courses.id]
  price decimal(12,2) [not null, note: 'Giá tại thời điểm mua (snapshot) — GV đổi giá sau không ảnh hưởng']

  indexes {
    (order_id, course_id) [unique]
  }
}

Table payments {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > orders.id]
  provider payment_provider [not null]
  provider_txn_id varchar(100) [unique, note: 'Mã giao dịch phía cổng thanh toán']
  amount decimal(12,2) [not null]
  status payment_status [not null, default: 'PENDING']
  raw_response jsonb [note: 'Lưu nguyên payload IPN/callback để đối soát']
  created_at timestamptz [not null, default: `now()`]
}

// ---------------------------------------------------------------------
// 5. Chat & thông báo
// ---------------------------------------------------------------------

Table conversations {
  id uuid [pk, default: `gen_random_uuid()`]
  teacher_id uuid [not null, ref: > users.id]
  student_id uuid [not null, ref: > users.id]
  last_message_at timestamptz [note: 'Để sắp xếp danh sách hội thoại']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (teacher_id, student_id) [unique]
    student_id
  }
}

Table messages {
  id uuid [pk, default: `gen_random_uuid()`]
  conversation_id uuid [not null, ref: > conversations.id]
  sender_id uuid [not null, ref: > users.id]
  content text [not null]
  attachment_url varchar(500)
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (conversation_id, created_at)
  }
}

Table notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  type varchar(50) [not null, note: 'NEW_MESSAGE, ASSIGNMENT_GRADED, NEW_ENROLLMENT, ...']
  title varchar(200) [not null]
  body text
  link varchar(500) [note: 'Đường dẫn FE khi bấm vào thông báo']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, read_at)
  }
}

// ---------------------------------------------------------------------
// Nhóm bảng (hiển thị thành khung trên dbdiagram.io)
// ---------------------------------------------------------------------

TableGroup users_and_courses {
  users
  categories
  courses
  sections
  lessons
}

TableGroup question_bank_and_quizzes {
  questions
  question_options
  quizzes
  quiz_questions
  quiz_attempts
  attempt_answers
}

TableGroup learning_and_progress {
  enrollments
  lesson_progress
  assignments
  submissions
  reviews
}

TableGroup commerce {
  orders
  order_items
  payments
}

TableGroup communication {
  conversations
  messages
  notifications
}
